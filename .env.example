# ─── Core ────────────────────────────────────────────────────────────────
# MongoDB connection string (Payload's database). Db name is `portfolio` — a
# fresh Payload database; the pre-migration Prisma data stays in its own db name.
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Source DB for the one-off P3.2b legacy-data migration (the pre-Payload
# `aolausoro` database). Only read by payload/scripts/migrate-legacy-data.ts.
LEGACY_DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/aolausoro?retryWrites=true&w=majority
# Encrypts Payload JWTs. Generate: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to validate Payload draft-preview requests
PREVIEW_SECRET=YOUR_PREVIEW_SECRET
# Public origin, no trailing slash. Used for CORS, sitemap, absolute links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM_ADDRESS=noreply@email.aolausoro.tech
EMAIL_FROM_NAME=aolausoro.tech

# ─── Media storage — DigitalOcean Spaces (S3-compatible) ─────────────────
# Backs the Payload `media` and `cvs` collections via @payloadcms/storage-s3.
DO_SPACES_REGION=lon1
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=https://your-bucket.lon1.cdn.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket
DO_SPACES_KEY=YOUR_SPACES_ACCESS_KEY
DO_SPACES_SECRET=YOUR_SPACES_SECRET_KEY

# ─── Local dev toggles ──────────────────────────────────────────────────
# Disable enforced payload-totp setup for local admin work (default: enforced).
# TOTP_FORCE_SETUP=false

# ─── reCAPTCHA (contact form) ────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SECRET_KEY

# ─── Transitional — removed in Phase 3 of the Payload migration ──────────
# Cloudinary (media, being replaced by DO Spaces above)
CLOUDINARY_NAME=YOUR_CLOUDINARY_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
NEXT_PUBLIC_CLOUDINARY_NAME=YOUR_CLOUDINARY_NAME
NEXT_PUBLIC_CLOUDINARY_PRESET=YOUR_CLOUDINARY_PRESET
# Sentry (observability — fate decided in Phase 3)
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
