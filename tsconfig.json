{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@components/*": ["components/*"],
      "@hooks/*": ["hooks/*"],
      "@lib/*": ["lib/*"],
      "@context/*": ["context/*"],
      "@models/*": ["models/*"],
      "@config/*": ["config/*"],
      "@app/*": ["app/*"],
      "@types/*": ["types/*"],
      "@public/*": ["public/*"],
      "@utils/*": ["utils/*"],
      "@access/*": ["access/*"],
      "@src/*": ["src/*"],
      "@di/*": ["di/*"],
      "@blocks/*": ["blocks/*"],
      "@fields/*": ["fields/*"],
      "@heroes/*": ["heroes/*"],
      "@search/*": ["search/*"],
      "@payload-types/*": ["./payload-types"],
      "@payload": ["payload/*"],
      "@payload-config": ["./payload.config.ts"],
      "@payload/importMaps": ["./app/(protected)/admin/importMap.js"],
      "@/utilities/ui": ["./lib/utils"],
      "@/utilities/*": ["./utils/*"],
      "@/*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "next.config.mjs",
    ".next/types/**/*.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "next-sitemap.config.cjs",
    "redirects.ts",
    "types/**/*.d.ts",
    "di/modules",
    ".next/dev/types/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"],
  "typeRoots": ["node_modules/@types", "./types/**.d.ts"]
}
